+void raopst_set_options(struct raopst_s *ctx, bool soft_flush, uint32_t prebuffer_ms) {
+	if (!ctx) return;
+	pthread_mutex_lock(&ctx->ab_mutex);
+	ctx->soft_flush = soft_flush;
+	ctx->prebuffer_ms = prebuffer_ms;
+	pthread_mutex_unlock(&ctx->ab_mutex);
+}
+
+bool raopst_get_stats(struct raopst_s *ctx, raopsr_stats_t *stats) {
+	if (!ctx || !stats) return false;
+	pthread_mutex_lock(&ctx->ab_mutex);
+	stats->written = ctx->ab_write;
+	stats->read = ctx->ab_read;
+	stats->fill = (uint16_t) (ctx->ab_write - ctx->ab_read + 1);
+	stats->last_write_ms = ctx->last_write_ms;
+	stats->last_read_ms = ctx->last_read_ms;
+	stats->first_rtp_ms = ctx->first_rtp_ms;
+	stats->first_sync_ms = ctx->first_sync_ms;
+	stats->first_audio_ms = ctx->first_audio_ms;
+	stats->http_connected = ctx->http_ready;
+	pthread_mutex_unlock(&ctx->ab_mutex);
+	return true;
+}
